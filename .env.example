# Copy this file to `.env` and fill in your values. Never commit `.env`.

PORT=5000

# Gmail example (use an App Password, not your normal password):
#   Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password

# Where contact-form messages are delivered (defaults to SMTP_USER)
MAIL_TO=you@gmail.com

# Optional: comma-separated allowed origins when frontend is hosted elsewhere
# CORS_ORIGIN=https://your-portfolio.com
